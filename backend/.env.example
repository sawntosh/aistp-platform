# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/aistp_db

# JWT
JWT_ACCESS_TOKEN_LIFETIME_HOURS=24

# Groq API (used for AI answer explanations and for RAG question
# generation from an uploaded syllabus document -- one provider/key for
# both, get a free key at https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key-here
EXPLANATION_GROQ_MODEL=openai/gpt-oss-20b
GENERATION_GROQ_MODEL=openai/gpt-oss-120b

# Rate limiting
RATELIMIT_LOGIN=20/m
RATELIMIT_EXPLAIN=10/m

# Email delivery for the verification / password-reset codes.
# EMAIL_PROVIDER: console (default, prints to the terminal) | smtp | gmail_api
EMAIL_PROVIDER=console

# --- EMAIL_PROVIDER=gmail_api ---
# Get the refresh token once with:
#   python scripts/gmail_oauth_setup.py "<downloaded client_secret_*.json>"
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
GMAIL_SENDER=youraddress@gmail.com
DEFAULT_FROM_EMAIL=AISTP <youraddress@gmail.com>

# --- EMAIL_PROVIDER=smtp (alternative: Gmail App Password) ---
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=youraddress@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-app-password
# EMAIL_PORT=587
# EMAIL_USE_TLS=1

# One-time code tuning (defaults shown)
EMAIL_OTP_MAX_AGE=600
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_COOLDOWN=60
