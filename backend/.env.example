# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/aistp_db

# JWT
JWT_ACCESS_TOKEN_LIFETIME_HOURS=24

# Groq API (used for AI answer explanations and for RAG question
# generation from an uploaded syllabus document -- one provider/key for
# both, get a free key at https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key-here
EXPLANATION_GROQ_MODEL=openai/gpt-oss-20b
GENERATION_GROQ_MODEL=openai/gpt-oss-120b

# Rate limiting
RATELIMIT_LOGIN=20/m
RATELIMIT_EXPLAIN=10/m
